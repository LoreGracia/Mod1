#version 430 core

// ─────────────────────────────────────────────────────────────────────
// Pase 1: splatting de densidad a una textura 3D.
//
// Cada partícula reparte su contribución (kernel de Wyvill) sobre los
// puntos de la rejilla que caen dentro de su radio de influencia. El
// Marching Cubes lee después esa textura y deja de recorrer partículas.
//
// Formato GL_R32UI + imageAtomicAdd (punto fijo) porque el atomic add
// de float en imágenes no es core hasta OpenGL 4.6.
// ─────────────────────────────────────────────────────────────────────

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// ─── Textura 3D de densidad (binding de imagen, no SSBO) ─────────────
layout(r32ui, binding = 0) uniform uimage3D uDensity;

// ─── SSBOs ───────────────────────────────────────────────────────────
// Cada partícula ocupa 2 vec4 (32 bytes):
//   posWeight = (position.xyz, splatWeight)
//   velAge    = (velocity.xyz, age)
struct GPUParticle {
    vec4 posWeight;
    vec4 velAge;
};

layout(std430, binding = 0) buffer ParticleBuffer {
    GPUParticle particles[];
};

layout(std430, binding = 2) buffer DrawCmdBuffer {
    uint vertexCount;
    uint instanceCount;
    uint firstVertex;
    uint baseInstance;
} drawCmd;

// ─── Uniforms ────────────────────────────────────────────────────────
uniform vec3  uGridMin;
uniform vec3  uGridMax;
uniform ivec3 uGridSize;       // número de vóxeles (la textura mide N+1)
uniform float uParticleRadius;
uniform float uDensityScale;   // densidad * escala -> uint
uniform int   uParticleCount;  // partículas válidas (no la capacidad del SSBO)
// Gotas que caen más rápido que esto NO aportan densidad (solo se dibujan
// como GL_POINTS). Evita que la lluvia en el aire genere metaballs flotantes.
uniform float uFallSpeedCutoff; // p.ej. -1.0

// ── Fase 3.7: filtro estricto de agua acumulada + aplanado ───────────
// Banda vertical (sobre uGridMin.y) donde se permite inyectar densidad.
uniform float uSplatHeight;     // p.ej. 0.15
// Techo absoluto: por encima de esto NUNCA se splatea, aunque esté quieta.
uniform float uSplatMaxHeight;  // p.ej. 0.22
// |velocity.y| <= esto => la partícula se considera asentada.
uniform float uSettleSpeed;     // p.ej. 0.5
// Compresión vertical del kernel (>1): las metaballs se fusionan en
// horizontal y la superficie queda plana como una lámina.
uniform float uSplatYScale;     // p.ej. 3.0

void main() {
    uint i = gl_GlobalInvocationID.x;

    // El primer invocation reinicia el comando de dibujo indirecto.
    // Se hace en GPU para no introducir un readback ni un upload síncrono.
    if (i == 0u) {
        drawCmd.vertexCount  = 0u;
        drawCmd.instanceCount = 1u;
        drawCmd.firstVertex  = 0u;
        drawCmd.baseInstance = 0u;
    }

    if (i >= uint(uParticleCount)) return;

    // w = splatWeight (0 = gota en caída, 1 = agua asentada).
    // El CPU clasifica por velocidad/Y y evita que las gotas formen
    // metaballs flotantes; esas gotas se dibujan como GL_POINTS.
    vec4  posWeight = particles[i].posWeight;
    float weight    = posWeight.w;
    if (weight <= 0.0) return;

    // Filtro en GPU: una gota que cae rápido (velocity.y < -1) no inyecta
    // densidad al volumen. Así el charco solo se forma con agua asentada.
    float vy = particles[i].velAge.y;
    if (vy < uFallSpeedCutoff) return;

    // ── Fase 3.7: solo agua acumulada en el fondo ───────────────────
    // Se permite splatear si está dentro de la banda baja O si está casi
    // quieta, pero SIEMPRE por debajo del techo duro. Las gotas en el aire
    // quedan fuera y se siguen dibujando como GL_POINTS.
    vec3  p     = posWeight.xyz;
    float relY  = p.y - uGridMin.y;
    bool  low   = relY <= uSplatHeight;
    bool  calm  = abs(vy) <= uSettleSpeed;
    if (!low && !calm) return;
    if (relY > uSplatMaxHeight) return;

    vec3  cell    = (uGridMax - uGridMin) / vec3(uGridSize);
    float cellMax = max(cell.x, max(cell.y, cell.z));
    int   R       = int(ceil(uParticleRadius / cellMax));

    vec3  g    = (p - uGridMin) / cell;
    ivec3 base = ivec3(round(g));

    float r2 = uParticleRadius * uParticleRadius;
    ivec3 texSize = uGridSize + ivec3(1);

    for (int dz = -R; dz <= R; ++dz)
    for (int dy = -R; dy <= R; ++dy)
    for (int dx = -R; dx <= R; ++dx) {
        ivec3 v = base + ivec3(dx, dy, dz);
        if (any(lessThan(v, ivec3(0))) || any(greaterThanEqual(v, texSize)))
            continue;

        vec3  gp = uGridMin + vec3(v) * cell;
        // Compresión anisotrópica: la distancia vertical pesa más, así el
        // campo se aplana y el iso se convierte en una lámina horizontal.
        vec3  d  = p - gp;
        d.y *= uSplatYScale;
        float d2 = dot(d, d);
        if (d2 >= r2) continue;

        float f = 1.0 - d2 / r2;
        float density = f * f * f * weight;
        imageAtomicAdd(uDensity, v, uint(density * uDensityScale));
    }
}
