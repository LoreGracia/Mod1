// ─────────────────────────────────────────────────────────────────────
// Density reading from the 3D texture (fixed-point -> float)
// ─────────────────────────────────────────────────────────────────────
/**
* @brief Reads the density at a given voxel index from the 3D texture.
* @param idx The 3D texture coordinate (voxel index).
* @return The density value as a float.
*/
float densityAt(ivec3 idx) {
	ivec3 c = clamp(idx, ivec3(0), uGridSize);
	float center = float(imageLoad(uDensity, c).r);

	// Read-time box blur over the six axis-aligned neighbours: smooths the
	// per-particle density bumps before Marching Cubes extracts the surface.
	float sum = 0.0;
	sum += float(imageLoad(uDensity, clamp(c + ivec3(1, 0, 0), ivec3(0), uGridSize)).r);
	sum += float(imageLoad(uDensity, clamp(c - ivec3(1, 0, 0), ivec3(0), uGridSize)).r);
	sum += float(imageLoad(uDensity, clamp(c + ivec3(0, 1, 0), ivec3(0), uGridSize)).r);
	sum += float(imageLoad(uDensity, clamp(c - ivec3(0, 1, 0), ivec3(0), uGridSize)).r);
	sum += float(imageLoad(uDensity, clamp(c + ivec3(0, 0, 1), ivec3(0), uGridSize)).r);
	sum += float(imageLoad(uDensity, clamp(c - ivec3(0, 0, 1), ivec3(0), uGridSize)).r);

	// uDensityBlur is the weight of each neighbour relative to the centre.
	float w = max(uDensityBlur, 0.0);
	float blurred = (center + w * sum) / (1.0 + 6.0 * w);
	return blurred / uDensityScale;
}

/**
* @brief Manual trilinear sampling of the density field.
* 
* The texture is GL_R32UI (integer), so it cannot use hardware GL_LINEAR filtering.
* We interpolate manually here to smooth the normals.
* 
* @param g The position in grid coordinates (voxel space).
* @return The interpolated density value.
*/
float densityTrilinear(vec3 g) {
	ivec3 i0 = ivec3(floor(g));
	i0 = clamp(i0, ivec3(0), uGridSize - ivec3(1));
	vec3 f = clamp(g - vec3(i0), 0.0, 1.0);

	float c000 = densityAt(i0 + ivec3(0, 0, 0));
	float c100 = densityAt(i0 + ivec3(1, 0, 0));
	float c010 = densityAt(i0 + ivec3(0, 1, 0));
	float c110 = densityAt(i0 + ivec3(1, 1, 0));
	float c001 = densityAt(i0 + ivec3(0, 0, 1));
	float c101 = densityAt(i0 + ivec3(1, 0, 1));
	float c011 = densityAt(i0 + ivec3(0, 1, 1));
	float c111 = densityAt(i0 + ivec3(1, 1, 1));

	float x00 = mix(c000, c100, f.x);
	float x10 = mix(c010, c110, f.x);
	float x01 = mix(c001, c101, f.x);
	float x11 = mix(c011, c111, f.x);
	return mix(mix(x00, x10, f.y), mix(x01, x11, f.y), f.z);
}

/**
* @brief Safely normalizes a vector, returning a fallback vector if length is zero.
* @param v The input vector.
* @return The normalized vector, or (0, 1, 0) if the input is near zero.
*/
vec3 safeNormalize(vec3 v) {
	float len = length(v);
	return (len > 1e-8) ? v / len : vec3(0.0, 1.0, 0.0);
}

/**
* @brief Calculates the smooth surface normal at a given world position.
* 
* Computes the gradient of the density field using central differences on
* trilinearly sampled density. The outward normal is the negative gradient
* (since water is high density). This produces true smooth shading without
* relying on dFdx/dFdy in the fragment shader.
* 
* @param worldPos The exact world position of the surface point.
* @param cell The cell size (vec3) of the grid.
* @return The normalized surface normal.
*/
vec3 surfaceNormal(vec3 worldPos, vec3 cell) {
	vec3 g = (worldPos - uGridMin) / cell;
	// Moderate gradient footprint smooths bumps without breaking reflections.
	const float h = 1.2;

	float dx = densityTrilinear(g + vec3(h, 0.0, 0.0))
			- densityTrilinear(g - vec3(h, 0.0, 0.0));
	float dy = densityTrilinear(g + vec3(0.0, h, 0.0))
			- densityTrilinear(g - vec3(0.0, h, 0.0));
	float dz = densityTrilinear(g + vec3(0.0, 0.0, h))
			- densityTrilinear(g - vec3(0.0, 0.0, h));

	vec3 grad = vec3(dx, dy, dz) / (2.0 * h * cell);
	return safeNormalize(-grad);
}

// ─────────────────────────────────────────────────────────────────────
// Edge position interpolation
// ─────────────────────────────────────────────────────────────────────
/**
* @brief Calculates the interpolation factor 't' along an edge.
*/
float edgeT(float iso, float v0, float v1) {
	if (abs(iso - v0) < 1e-6) return 0.0;
	if (abs(iso - v1) < 1e-6) return 1.0;
	if (abs(v0 - v1) < 1e-6)  return 0.0;
	return clamp((iso - v0) / (v1 - v0), 0.0, 1.0);
}

/**
* @brief Computes the exact position of the isosurface along an edge.
*/
vec3 edgePosition(float iso, vec3 p0, vec3 p1, float v0, float v1) {
	return mix(p0, p1, edgeT(iso, v0, v1));
}

// ─────────────────────────────────────────────────────────────────────
// main
// ─────────────────────────────────────────────────────────────────────
/**
* @brief Core Marching Cubes logic.
* 
* Evaluates a voxel, determines the active edges based on the isosurface,
* interpolates positions and normals, and emits triangles using atomicAdd.
*/
void main() {
	ivec3 voxel = ivec3(gl_GlobalInvocationID);
	if (voxel.x >= uGridSize.x || voxel.y >= uGridSize.y || voxel.z >= uGridSize.z)
		return;

	vec3 cell = (uGridMax - uGridMin) / vec3(uGridSize);
	vec3 base = uGridMin + vec3(voxel) * cell;

	// 8 corners of the voxel (Paul Bourke convention)
	vec3 c[8] = vec3[8](
		base + vec3(0,0,0) * cell,
		base + vec3(1,0,0) * cell,
		base + vec3(1,1,0) * cell,
		base + vec3(0,1,0) * cell,
		base + vec3(0,0,1) * cell,
		base + vec3(1,0,1) * cell,
		base + vec3(1,1,1) * cell,
		base + vec3(0,1,1) * cell
	);

	// Texture indices for those 8 corners. The texture is N+1 in size,
	// so voxel + offset is always within [0, N].
	ivec3 ci[8] = ivec3[8](
		voxel + ivec3(0,0,0),
		voxel + ivec3(1,0,0),
		voxel + ivec3(1,1,0),
		voxel + ivec3(0,1,0),
		voxel + ivec3(0,0,1),
		voxel + ivec3(1,0,1),
		voxel + ivec3(1,1,1),
		voxel + ivec3(0,1,1)
	);

	// Density at each corner (read from the 3D texture)
	float d[8];
	for (int i = 0; i < 8; ++i) d[i] = densityAt(ci[i]);

	// cubeIndex: bit i = 1 if corner i is INSIDE the water.
	// We use d >= isoLevel because our "solid" is the water (high density).
	int cubeIndex = 0;
	for (int i = 0; i < 8; ++i)
		if (d[i] >= uIsoLevel) cubeIndex |= (1 << i);

	int edges = edgeTable[cubeIndex];
	if (edges == 0) return;

	// Interpolate the 12 edge points and calculate their smooth normal
	// at the exact surface point (trilinear gradient). Done once per
	// active edge and reused in triangles (cheaper than per emitted vertex).
	// GLSL requires explicit bool condition -> compare against 0.
	vec3 ev[12];
	vec3 en[12];
	if ((edges &    1) != 0) { ev[0]  = edgePosition(uIsoLevel, c[0], c[1], d[0], d[1]); en[0]  = surfaceNormal(ev[0],  cell); }
	if ((edges &    2) != 0) { ev[1]  = edgePosition(uIsoLevel, c[1], c[2], d[1], d[2]); en[1]  = surfaceNormal(ev[1],  cell); }
	if ((edges &    4) != 0) { ev[2]  = edgePosition(uIsoLevel, c[2], c[3], d[2], d[3]); en[2]  = surfaceNormal(ev[2],  cell); }
	if ((edges &    8) != 0) { ev[3]  = edgePosition(uIsoLevel, c[3], c[0], d[3], d[0]); en[3]  = surfaceNormal(ev[3],  cell); }
	if ((edges &   16) != 0) { ev[4]  = edgePosition(uIsoLevel, c[4], c[5], d[4], d[5]); en[4]  = surfaceNormal(ev[4],  cell); }
	if ((edges &   32) != 0) { ev[5]  = edgePosition(uIsoLevel, c[5], c[6], d[5], d[6]); en[5]  = surfaceNormal(ev[5],  cell); }
	if ((edges &   64) != 0) { ev[6]  = edgePosition(uIsoLevel, c[6], c[7], d[6], d[7]); en[6]  = surfaceNormal(ev[6],  cell); }
	if ((edges &  128) != 0) { ev[7]  = edgePosition(uIsoLevel, c[7], c[4], d[7], d[4]); en[7]  = surfaceNormal(ev[7],  cell); }
	if ((edges &  256) != 0) { ev[8]  = edgePosition(uIsoLevel, c[0], c[4], d[0], d[4]); en[8]  = surfaceNormal(ev[8],  cell); }
	if ((edges &  512) != 0) { ev[9]  = edgePosition(uIsoLevel, c[1], c[5], d[1], d[5]); en[9]  = surfaceNormal(ev[9],  cell); }
	if ((edges & 1024) != 0) { ev[10] = edgePosition(uIsoLevel, c[2], c[6], d[2], d[6]); en[10] = surfaceNormal(ev[10], cell); }
	if ((edges & 2048) != 0) { ev[11] = edgePosition(uIsoLevel, c[3], c[7], d[3], d[7]); en[11] = surfaceNormal(ev[11], cell); }

	// Emit triangles with atomicAdd on the indirect draw command
	for (int i = 0; triTable[cubeIndex][i] != -1; i += 3) {
		uint dst = atomicAdd(drawCmd.vertexCount, 3u);
		int i0 = triTable[cubeIndex][i + 0];
		int i1 = triTable[cubeIndex][i + 1];
		int i2 = triTable[cubeIndex][i + 2];

		vertices[dst + 0].position = vec4(ev[i0], 1.0);
		vertices[dst + 1].position = vec4(ev[i1], 1.0);
		vertices[dst + 2].position = vec4(ev[i2], 1.0);

		vertices[dst + 0].normal = vec4(en[i0], 0.0);
		vertices[dst + 1].normal = vec4(en[i1], 0.0);
		vertices[dst + 2].normal = vec4(en[i2], 0.0);
	}
}