#version 430 core

/**
* @file marching_cubes.comp
* @brief GPU Marching Cubes (Compute Shader).
* 
* Generates a triangle mesh from a density field built from the 3D texture
* produced by the density_splat pass. It reads the density, calculates smooth
* normals via the gradient, and outputs vertices directly to an SSBO.
*/

// Workgroup size. Must match the (4,4,4) used in dispatchForGrid.
layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

// ─── Uniforms ────────────────────────────────────────────────────────
uniform vec3  uGridMin;       ///< Minimum bounds of the simulation grid.
uniform vec3  uGridMax;       ///< Maximum bounds of the simulation grid.
uniform ivec3 uGridSize;      ///< Number of voxels in each dimension.
uniform float uIsoLevel;      ///< The threshold value to extract the surface.
uniform float uDensityScale;  ///< Scale used to convert fixed-point density back to float.
uniform float uDensityBlur;   ///< Neighbour weight of the six-tap density blur (0 disables it).

// ─── 3D Density Texture generated by density_splat.comp ──────────────
// The texture size is (uGridSize + 1) in each axis: its texels match
// exactly with the voxel corners.
layout(r32ui, binding = 0) uniform readonly uimage3D uDensity;

// ─── SSBOs (bindings must match GPUMarchingCubes.cpp) ────────────────
/**
* @struct Vertex
* @brief Represents a single output vertex containing position and normal.
*/
struct Vertex {
	vec4 position;   ///< xyz = position, w = 1.0.
	vec4 normal;     ///< xyz = smooth normal, w = 0.0.
};

layout(std430, binding = 1) buffer VertexBuffer { Vertex vertices[]; };

// The same SSBO that density_splat.comp resets. The compute shader increments
// vertexCount and the render pipeline uses it for glDrawArraysIndirect.
layout(std430, binding = 2) buffer DrawCmdBuffer {
	uint vertexCount;
	uint instanceCount;
	uint firstVertex;
	uint baseInstance;
} drawCmd;

